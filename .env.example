# TransFireRisk IMS — API Key Configuration
# Copy this file to .env and fill in your keys

# Korea Meteorological Administration (기상청) Short-term Forecast API
# Register at: https://data.go.kr → 기상청_단기예보 조회서비스
KMA_API_KEY=your_kma_api_key_here

# OpenAI API Key (for AI operational briefings and inspection guides)
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
